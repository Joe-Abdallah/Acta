<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.csis231.javafxclient.controller.Visual3DController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Top 5 Most Upvoted Posts" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <Separator/>

    <StackPane fx:id="container3D" VBox.vgrow="ALWAYS" style="-fx-background-color: #111111;"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #888888;"/>

</VBox>