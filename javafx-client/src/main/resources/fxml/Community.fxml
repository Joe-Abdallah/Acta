<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.csis231.javafxclient.controller.CommunityController">

    <left>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Communities" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <ListView fx:id="communityList" prefWidth="250" prefHeight="500"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20;">
            <Label text="Create a New Community" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
                <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="descField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="80"/>
            </GridPane>
            <Button fx:id="createCommunityBtn" text="Create Community" onAction="#handleCreateCommunity"/>
            <Label fx:id="statusLabel"/>
        </VBox>
    </center>

    <right>
        <!-- Community detail pane — shown when a community is selected in the list -->
        <VBox fx:id="communityDetailPane" spacing="10" style="-fx-padding: 15; -fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;" prefWidth="280" managed="false" visible="false">
            <Label text="Community Info" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
            <Separator/>
            <Label fx:id="communityDetailName" style="-fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
            <Label text="Description:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
            <TextArea fx:id="communityDetailDesc"
                      editable="false"
                      wrapText="true"
                      prefHeight="200"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
        </VBox>
    </right>

</BorderPane>
